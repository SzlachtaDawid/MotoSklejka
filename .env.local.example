# Copy to .env.local:  cp .env.local.example .env.local
#
# This file is read by Next.js only, and takes precedence over .env.
# Do not put DATABASE_URL here — it belongs in .env, see .env.example.
# Note: .env.local is NOT loaded when NODE_ENV=test.

# Secret used to sign JWT sessions (next-auth v5). Generate one: npx auth secret
AUTH_SECRET=""

# Google Maps JavaScript API key (Google Cloud Console -> Credentials).
# NEXT_PUBLIC_* is inlined into the client bundle, so restrict the key by HTTP referrer.
NEXT_PUBLIC_GOOGLE_MAPS_KEY_DEMO=""
