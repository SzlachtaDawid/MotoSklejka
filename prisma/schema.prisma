generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  trips     Trip[]
}

model Trip {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id])
  startDateTime       DateTime
  destination         String
  groupSize           Int
  estimatedDuration   String
  estimatedDistanceKm Int
  returnToStart       Boolean  @default(false)
  motorcycleTypes     String[]
  ridingStyle         String[]
  lat                 Float
  lng                 Float
  createdAt           DateTime @default(now())

  @@index([userId, startDateTime])
}
