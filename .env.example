# Copy to .env:  cp .env.example .env
#
# This file is read by the Prisma CLI (via prisma.config.ts -> dotenv) AND by Next.js.
# DATABASE_URL must live HERE, not in .env.local — dotenv does not read .env.local,
# so `npx prisma migrate dev` / `npx prisma generate` would fail without it.

# Neon Postgres connection string (Neon Dashboard -> project -> Connection string).
DATABASE_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/dbname?sslmode=require"
